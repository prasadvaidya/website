---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    <p class="lede">{description}</p>
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
  }

  h1 {
    max-width: 56rem;
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    line-height: 1.02;
  }

  h1 :global(em) {
    color: var(--accent);
    font-style: italic;
  }

  .lede {
    max-width: 44rem;
    margin: 1.4rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.7;
  }
</style>
