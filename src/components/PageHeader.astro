---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    max-width: 58rem;
    margin: 0.4rem 0 0;
    font-size: clamp(2.8rem, 8vw, 6.3rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  p:not(.eyebrow) {
    max-width: 48rem;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
  }
</style>
