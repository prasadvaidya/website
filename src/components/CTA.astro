---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  primaryEventName?: string;
  analyticsLocation?: string;
}

const {
  eyebrow = "Continue",
  title = "Read the technical notes.",
  description = "Explore writing on software architecture, AI workflows, product engineering, and the systems behind sustained technical craft.",
  primaryLabel = "Read writing",
  primaryHref = "/writing/",
  primaryEventName,
  analyticsLocation = "cta"
} = Astro.props;

function defaultEventFor(label: string, href: string) {
  const normalizedLabel = label.toLowerCase();
  if (href === "/rss.xml" || normalizedLabel.includes("subscribe")) return "subscribe_click";
  if (normalizedLabel.includes("writing") || href.startsWith("/writing")) return "read_writing_click";
  if (normalizedLabel.includes("project") || href.startsWith("/projects")) return "view_projects_click";
  if (
    normalizedLabel.includes("work") ||
    normalizedLabel.includes("touch") ||
    normalizedLabel.includes("discuss") ||
    href.startsWith("/contact")
  ) {
    return "cta_click";
  }
  return "cta_click";
}

const primaryAnalyticsEvent = primaryEventName ?? defaultEventFor(primaryLabel, primaryHref);
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container cta-card">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="cta-title">{title}</h2>
      <p>{description}</p>
    </div>
    <div class="cta-actions">
      <a
        class="button button-primary"
        href={primaryHref}
        data-analytics-event={primaryAnalyticsEvent}
        data-analytics-category="cta"
        data-analytics-label={primaryLabel}
        data-analytics-location={analyticsLocation}
      >
        {primaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--surface-muted) 72%, transparent));
    padding: clamp(1.4rem, 4vw, 2.3rem);
  }

  h2 {
    max-width: 48rem;
    margin: 0.35rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.05;
  }

  p:not(.eyebrow) {
    max-width: 43rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.04rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  @media (max-width: 760px) {
    .cta-card {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
