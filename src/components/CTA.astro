---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  primaryEventName?: string;
  analyticsLocation?: string;
}

const {
  eyebrow = "Continue",
  title = "Keep reading the notebook.",
  description = "Projects, experiments, and notes on architecture, AI systems, and the craft of building.",
  primaryLabel = "Read writing",
  primaryHref = "/writing/",
  primaryEventName,
  analyticsLocation = "cta"
} = Astro.props;

function defaultEventFor(label: string, href: string) {
  const normalizedLabel = label.toLowerCase();
  if (href === "/rss.xml" || normalizedLabel.includes("subscribe")) return "subscribe_click";
  if (normalizedLabel.includes("writing") || href.startsWith("/writing")) return "read_writing_click";
  if (normalizedLabel.includes("project") || href.startsWith("/projects")) return "view_projects_click";
  return "cta_click";
}

const primaryAnalyticsEvent = primaryEventName ?? defaultEventFor(primaryLabel, primaryHref);
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container cta-card">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="cta-title">{title}</h2>
      <p>{description}</p>
    </div>
    <div class="cta-actions">
      <a
        class="button button-primary"
        href={primaryHref}
        data-analytics-event={primaryAnalyticsEvent}
        data-analytics-category="cta"
        data-analytics-label={primaryLabel}
        data-analytics-location={analyticsLocation}
      >
        {primaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    padding: clamp(1.5rem, 4vw, 2.4rem);
  }

  h2 {
    max-width: 44rem;
    margin: 0.6rem 0 0;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    line-height: 1.08;
  }

  p:not(.eyebrow) {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  @media (max-width: 720px) {
    .cta-card {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
