---
interface Props {
  href: string;
  title: string;
  problem: string;
  stack: string[];
  status: string;
  index?: number;
}

const { href, title, problem, stack, status, index } = Astro.props;
const indexLabel = typeof index === "number" ? String(index + 1).padStart(2, "0") : undefined;
---

<article class="project-row">
  <a
    href={href}
    aria-label={`View ${title}`}
    data-analytics-event="project_view"
    data-analytics-category="project"
    data-analytics-label={title}
    data-analytics-location="project_card"
  >
    {indexLabel && <span class="row-index" aria-hidden="true">{indexLabel}</span>}
    <div class="row-main">
      <div class="row-top">
        <h3>{title}</h3>
        <span class="chip chip-accent">{status}</span>
      </div>
      <p>{problem}</p>
      <div class="stack" aria-label="Technology stack">
        {stack.slice(0, 5).map((item) => <span class="chip">{item}</span>)}
      </div>
    </div>
    <span class="row-arrow" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .project-row {
    border-top: 1px solid var(--border);
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project-row a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(1rem, 3vw, 2rem);
    padding: clamp(1.3rem, 3vw, 1.8rem) 0.5rem;
    transition: background 160ms ease;
  }

  .project-row a:hover {
    background: color-mix(in srgb, var(--surface-muted) 45%, transparent);
  }

  .row-index {
    color: var(--accent);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    padding-top: 0.4rem;
  }

  .row-main {
    display: grid;
    gap: 0.7rem;
  }

  .row-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.15;
  }

  p {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .row-arrow {
    color: var(--muted);
    font-size: 1.15rem;
    padding-top: 0.35rem;
    transition:
      transform 160ms ease,
      color 160ms ease;
  }

  .project-row a:hover .row-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .project-row a {
      grid-template-columns: minmax(0, 1fr);
    }

    .row-index,
    .row-arrow {
      display: none;
    }
  }
</style>
