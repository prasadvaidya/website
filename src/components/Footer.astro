---
import { navItems, site } from "../utils/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href="/">Prasad Vaidya<span>.</span></a>
      <p>
        A working notebook on software architecture, AI systems, and the
        personal systems behind steady work.
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer navigation">
      <span class="col-label">Index</span>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label="Footer links">
      <span class="col-label">Elsewhere</span>
      <a href={site.socials.github}>GitHub</a>
      <a href={site.socials.linkedin}>LinkedIn</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>

  <div class="container colophon">
    <span>© {year} Prasad Vaidya</span>
    <span>Built by hand with Astro · Set in Fraunces, Inter & JetBrains Mono</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-muted) 38%, transparent);
    padding-block: clamp(2rem, 5vw, 3.25rem) 1.4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto auto;
    gap: 2rem clamp(2rem, 8vw, 6rem);
  }

  .brand {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.12rem;
    font-weight: 620;
  }

  .brand span {
    color: var(--accent);
  }

  .footer-brand p {
    max-width: 24rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-col {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }

  .col-label {
    margin-bottom: 0.35rem;
    color: var(--accent);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer-col a {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
    color: var(--muted);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
