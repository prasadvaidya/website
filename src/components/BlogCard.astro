---
import { formatDate } from "../utils/site";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  readingTime: string;
  category: string;
  tags: string[];
}

const { href, title, description, pubDate, readingTime, category, tags } = Astro.props;
---

<article class="post-row">
  <a
    href={href}
    aria-label={`Read ${title}`}
    data-analytics-event="writing_click"
    data-analytics-category="writing"
    data-analytics-label={title}
    data-analytics-location="blog_card"
  >
    <div class="post-meta">
      <span class="meta-date">{formatDate(pubDate)}</span>
      <span>{category}</span>
      <span>{readingTime}</span>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    {tags.length > 0 && (
      <div class="tags" aria-label="Post tags">
        {tags.slice(0, 3).map((tag) => <span class="chip">{tag}</span>)}
      </div>
    )}
  </a>
</article>

<style>
  .post-row {
    border-top: 1px solid var(--border);
  }

  .post-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .post-row a {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.2rem, 3vw, 1.6rem) 0.5rem;
    transition: background 160ms ease;
  }

  .post-row a:hover {
    background: color-mix(in srgb, var(--surface-muted) 45%, transparent);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    color: var(--muted);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .meta-date {
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.18;
  }

  .post-row a:hover h3 {
    color: var(--accent-strong);
  }

  :global(.dark) .post-row a:hover h3 {
    color: var(--accent);
  }

  p {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }
</style>
