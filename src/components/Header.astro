---
import ThemeToggle from "./ThemeToggle.astro";
import { navItems } from "../utils/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Prasad Vaidya home">
      Prasad Vaidya<span class="brand-dot">.</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a
        class="hello-link"
        href="/about/#connect"
        data-analytics-event="cta_click"
        data-analytics-category="cta"
        data-analytics-label="Say hello"
        data-analytics-location="header"
      >
        Say hello
      </a>
      <button class="menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" data-menu-button>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation" data-mobile-nav>
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a
      class="mobile-cta"
      href="/about/#connect"
      data-analytics-event="cta_click"
      data-analytics-category="cta"
      data-analytics-label="Say hello"
      data-analytics-location="mobile_nav"
    >
      Say hello
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    background: color-mix(in srgb, var(--background) 86%, transparent);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 4.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    min-width: max-content;
    font-family: Fraunces, Georgia, serif;
    font-size: 1.12rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .brand-dot {
    color: var(--accent);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .desktop-nav a {
    color: var(--muted);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .desktop-nav a:hover {
    color: var(--text);
  }

  .desktop-nav a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .header-actions {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: 0.55rem;
  }

  .hello-link {
    display: inline-flex;
    min-height: 2.4rem;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--text);
    color: var(--background);
    font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    transition: background 160ms ease;
  }

  .hello-link:hover {
    background: var(--accent-strong);
  }

  :global(.dark) .hello-link:hover {
    background: var(--accent);
  }

  .menu-button {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    grid-area: 1 / 1;
    width: 1rem;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .menu-button span:first-child {
    transform: translateY(-4px);
  }

  .menu-button span:last-child {
    transform: translateY(4px);
  }

  .menu-button[aria-expanded="true"] span:first-child {
    transform: rotate(45deg);
  }

  .menu-button[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 820px) {
    .desktop-nav,
    .hello-link {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .mobile-nav {
      display: grid;
      max-height: 0;
      overflow: hidden;
      border-top: 1px solid transparent;
      padding-inline: 1.25rem;
      transition:
        max-height 220ms ease,
        border-color 220ms ease,
        padding-block 220ms ease;
    }

    .mobile-nav[data-open="true"] {
      max-height: 26rem;
      border-color: var(--border);
      padding-block: 0.75rem 1rem;
    }

    .mobile-nav a {
      border-radius: 4px;
      color: var(--muted);
      font-family: "JetBrains Mono", SFMono-Regular, Consolas, monospace;
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.78rem 0.85rem;
    }

    .mobile-nav a[aria-current="page"] {
      background: var(--surface-muted);
      color: var(--text);
    }

    .mobile-cta {
      margin-top: 0.35rem;
      background: var(--text);
      color: var(--background) !important;
      text-align: center;
    }
  }
</style>

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const mobileNav = document.querySelector("[data-mobile-nav]");

  menuButton?.addEventListener("click", () => {
    const expanded = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!expanded));
    if (expanded) {
      mobileNav?.removeAttribute("data-open");
    } else {
      mobileNav?.setAttribute("data-open", "true");
    }
    document.body.classList.toggle("menu-open", !expanded);
  });
</script>
