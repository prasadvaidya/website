---
import ThemeToggle from "./ThemeToggle.astro";
import { navItems } from "../utils/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
const isHome = currentPath === "/";
---

<header class="site-header">
  <div class="container header-inner">
    {isHome ? <span /> : <a class="brand" href="/">Prasad Vaidya</a>}
    <nav aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 1.6rem 0.5rem;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .brand {
    font-weight: 600;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1.1rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.95rem;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }
</style>
