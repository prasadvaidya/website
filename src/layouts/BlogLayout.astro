---
import BaseLayout from "./BaseLayout.astro";
import { absoluteUrl, site } from "../utils/site";

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  readingTime?: string;
  category?: string;
  tags?: string[];
  canonical?: string;
  audience?: string;
  problem?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
  articleImages?: string[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  readingTime,
  category,
  tags = [],
  canonical,
  audience,
  problem,
  ctaLabel,
  ctaHref,
  image = "/og-default.png",
  imageAlt,
  articleImages = []
} = Astro.props;
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = canonicalPath.startsWith("http") ? canonicalPath : absoluteUrl(canonicalPath);
const hasValidationCta = Boolean(ctaLabel && ctaHref);
const metaParts = [
  readingTime,
  category
].filter(Boolean);
const blogPostingStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  keywords: tags,
  articleSection: category,
  image: (articleImages.length > 0 ? articleImages : [image]).map((item) => absoluteUrl(item)),
  audience: audience ? { "@type": "Audience", audienceType: audience } : undefined,
  about: problem,
  inLanguage: "en",
  isPartOf: {
    "@type": "Blog",
    name: `${site.name} Writing`,
    url: absoluteUrl("/writing/")
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalPath}
  image={image}
  imageAlt={imageAlt ?? title}
  ogType="article"
  articlePublishedTime={pubDate?.toISOString()}
  articleModifiedTime={(updatedDate ?? pubDate)?.toISOString()}
  articleSection={category}
  articleTags={tags}
  includeStructuredAuthor={false}
  structuredData={blogPostingStructuredData}
>
  <article class="container page">
    <p class="back">
      <a class="link" href="/writing/">← Writing</a>
    </p>
    <h1>{title}</h1>
    {metaParts.length > 0 && <p class="meta">{metaParts.join(" · ")}</p>}
    <div class="prose-custom body">
      <slot />
    </div>
    {
      hasValidationCta && (
        <p class="article-cta">
          <a
            class="link"
            href={ctaHref}
            data-analytics-event="idea_interest_click"
            data-analytics-category="validation"
            data-analytics-label={ctaLabel}
            data-analytics-location="article_footer"
          >
            {ctaLabel}
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .back {
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }

  h1 {
    max-width: 38rem;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .meta {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .body {
    max-width: 38rem;
    margin-top: 2rem;
  }

  .article-cta {
    margin-top: 2rem;
  }
</style>
