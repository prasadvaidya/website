---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../utils/site";

const profileLinks = [
  {
    label: "LinkedIn",
    href: site.socials.linkedin,
    eyebrow: "Professional context",
    description: "Career, technical background, and professional updates."
  },
  {
    label: "GitHub",
    href: site.socials.github,
    eyebrow: "Code and experiments",
    description: "Projects, technical experiments, and work-in-progress."
  }
];
---

<BaseLayout
  title="Find me"
  description="Official GitHub and LinkedIn profiles for Prasad Vaidya."
>
  <section class="links-page">
    <div class="container">
      <header class="links-heading">
        <p class="eyebrow">Find me</p>
        <h1>Find me online.</h1>
        <p>
          GitHub and LinkedIn are the best places to follow my work, projects,
          technical notes, and other updates.
        </p>
      </header>

      <div class="profile-grid" aria-label="Profile links">
        {
          profileLinks.map((link) => (
            <a
              class="card profile-card"
              href={link.href}
              data-analytics-event="profile_click"
              data-analytics-category="profile"
              data-analytics-label={link.label}
            >
              <span class="profile-eyebrow">{link.eyebrow}</span>
              <h2>{link.label}</h2>
              <p>{link.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .links-page {
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
  }

  .links-heading {
    max-width: 48rem;
  }

  .links-heading h1 {
    margin: 0.25rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .links-heading p:not(.eyebrow) {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    line-height: 1.7;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .profile-card {
    display: grid;
    gap: 0.8rem;
    min-height: 16rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .profile-card:hover {
    border-color: var(--accent);
  }

  .profile-eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.15;
  }

  .profile-card p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .profile-url {
    align-self: end;
    color: var(--text);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .profile-card {
      min-height: 13rem;
    }
  }
</style>
