---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, site, sortByDate, sortProjectsByMaturity } from "../utils/site";

const posts = sortByDate((await getCollection("blog")).filter((post) => !post.data.draft));
const projects = sortProjectsByMaturity(await getCollection("projects"));
const products = (await getCollection("products")).filter((product) => !product.data.draft);
const rootProducts = products
  .filter((product) => !product.data.parentProduct)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const useCasesFor = (productId: string) =>
  products.filter((product) => product.data.parentProduct === productId);
---

<BaseLayout>
  <div class="container home">
    <section class="intro">
      <h1>Prasad Vaidya</h1>
      <p>
        I'm a technical architect. I design backend systems and SaaS platforms for
        startups, and most of my time now goes to AI products, both for the companies
        I work with and in tools I build for myself.
      </p>
      <p>
        Away from the keyboard I'm learning jazz guitar, building health, and
        working out what it takes to ship products of my own. This site is where I
        keep track of all of it.
      </p>
    </section>

    {
      rootProducts.length > 0 && (
        <section>
          <h2>Products</h2>
          <ul class="item-list">
            {rootProducts.map((product) => (
              <li>
                <p class="item-title">
                  <a class="link" href={`/products/${product.id}/`}>
                    {product.data.title}
                  </a>
                  <span class="item-status">
                    ({product.data.mode === "live" ? "available" : "early access"})
                  </span>
                </p>
                <p class="item-desc">{product.data.description}</p>
                {useCasesFor(product.id).map((useCase) => (
                  <p class="item-sub">
                    <a class="link" href={`/products/${useCase.id}/`}>
                      {useCase.data.listingTitle}
                    </a>
                    <span class="item-status">for {useCase.data.listingAudience}</span>
                  </p>
                ))}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2>Projects</h2>
      <ul class="item-list">
        {
          projects.map((project) => (
            <li>
              <p class="item-title">
                <a class="link" href={`/projects/${project.id}/`}>
                  {project.data.title}
                </a>
                <span class="item-status">({project.data.status.toLowerCase()})</span>
              </p>
              <p class="item-desc">{project.data.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Writing</h2>
      {
        posts.length === 0 ? (
          <p>
            Nothing published yet. The first drafts cover architecture decisions, AI
            workflows, and the systems side of health and guitar practice. There's an
            <a class="link" href="/rss.xml">RSS feed</a> if you'd like new notes as
            they appear.
          </p>
        ) : (
          <ul class="item-list">
            {posts.slice(0, 5).map((post) => (
              <li>
                <p class="item-title">
                  <a class="link" href={`/writing/${post.id}/`}>
                    {post.data.title}
                  </a>
                  <span class="item-status">{formatDate(post.data.pubDate)}</span>
                </p>
              </li>
            ))}
            <li>
              <p class="item-title">
                <a class="link" href="/writing/">
                  All writing
                </a>
              </p>
            </li>
          </ul>
        )
      }
    </section>

    <section>
      <h2>Now</h2>
      <p>
        Pushing the knowledge base toward something I can use every day, running local
        LLM experiments in the evenings, and practicing guitar most days. The{" "}
        <a class="link" href="/now/">now page</a> has the longer version.
      </p>
    </section>

    <section>
      <h2>Elsewhere</h2>
      <ul class="item-list">
        <li>
          <p class="item-title">
            <a class="link" href={site.socials.github}>GitHub</a>
            <span class="item-status">code, experiments, works in progress</span>
          </p>
        </li>
        <li>
          <p class="item-title">
            <a class="link" href={site.socials.linkedin}>LinkedIn</a>
            <span class="item-status">the professional record</span>
          </p>
        </li>
      </ul>
      <p class="hello">If you're building something interesting, say hello on either.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: clamp(2.2rem, 5vw, 3rem);
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .intro p {
    max-width: 38rem;
    margin: 0.9rem 0 0;
  }

  h2 {
    margin: 0 0 0.9rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  section p {
    max-width: 38rem;
  }

  .item-list {
    display: grid;
    gap: 1.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item-title {
    margin: 0;
  }

  .item-status {
    margin-left: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .item-desc {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .item-sub {
    margin: 0.35rem 0 0 1rem;
    font-size: 0.95rem;
  }

  .item-sub:first-of-type {
    margin-top: 0.6rem;
  }

  .hello {
    margin: 1.1rem 0 0;
    color: var(--muted);
  }
</style>
