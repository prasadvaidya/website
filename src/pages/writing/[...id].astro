---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  readingTime={post.data.readingTime}
  category={post.data.category}
  tags={post.data.tags}
  audience={post.data.audience}
  problem={post.data.problem}
  ctaLabel={post.data.ctaLabel}
  ctaHref={post.data.ctaHref}
  image={post.data.ogImage}
  imageAlt={post.data.ogImageAlt}
  articleImages={post.data.articleImages}
  canonical={`/writing/${post.id}/`}
>
  <Content />
</BlogLayout>
