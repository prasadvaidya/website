---
import CTA from "../components/CTA.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const strengths = [
  "System Design",
  "Cloud-native Architecture",
  "Backend Engineering",
  "AI Product Architecture",
  "SaaS Platforms",
  "Team Technical Leadership",
  "Performance & Scalability",
  "Developer Tooling"
];

const domains = [
  "SaaS platforms and multi-tenant products",
  "Backend services, APIs, queues, and data flows",
  "AI-enabled product workflows and classification systems",
  "Developer productivity and internal engineering systems"
];

const caseStudies = [
  {
    title: "SaaS Architecture Decisions",
    text: "How product risk, data ownership, operating load, and team size shape the right first architecture."
  },
  {
    title: "AI Workflow Design",
    text: "Patterns for turning vague AI automation ideas into bounded workflows with explicit failure modes and human review."
  },
  {
    title: "Backend Reliability",
    text: "A structured view of queues, retries, rate limits, data boundaries, and observability for systems that need to run with confidence."
  }
];
---

<BaseLayout
  title="Architecture"
  description="Architecture principles, system design judgment, and technical operating models from Prasad Vaidya."
>
  <PageHeader
    eyebrow="Architecture"
    title="Technical architecture with product judgment."
    description="A working view of how I reason about software systems, AI workflows, product constraints, and engineering operating models."
  />

  <section class="section-tight">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Architecture Practice</p>
        <h2>Principal-level thinking for systems that need to last.</h2>
      </div>
      <div class="copy">
        <p>
          My architecture lens sits between system design, product engineering, and team execution.
          I care about the shape of systems, but also the operating model around them: who changes
          them, how failures surface, how teams make decisions, and what technical choices actually
          serve the product.
        </p>
        <p>
          The goal is not novelty. The goal is technical clarity: simple systems that can grow,
          AI workflows with explicit trust boundaries, and engineering defaults that reduce drag.

        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Technical Strengths</p>
        <h2>Architecture depth across the product stack.</h2>
      </div>
      <div class="strength-grid">
        {strengths.map((strength) => <span>{strength}</span>)}
      </div>
    </div>
  </section>

  <section class="section philosophy-band">
    <div class="container philosophy">
      <p class="eyebrow">Architecture Philosophy</p>
      <blockquote>
        I prefer simple systems that scale through clarity first, not accidental complexity. My work
        focuses on reducing operational risk, improving developer velocity, and choosing technology
        based on business constraints.
      </blockquote>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Domains</p>
        <h2>Systems and product areas I think about.</h2>
      </div>
      <ul class="domain-list">
        {domains.map((domain) => <li>{domain}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Leadership Style</p>
        <h2>Calm technical direction with clear tradeoffs.</h2>
      </div>
      <div class="copy">
        <p>
          I value technical leadership that makes teams more capable. That means writing down context,
          helping engineers see constraints clearly, establishing feedback loops, and turning ambiguity
          into practical next steps.
        </p>
        <p>
          The goal is not to win architecture debates. The goal is to reduce uncertainty, protect future
          options, and help the team deliver reliable software with less operational surprise.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-heading split">
        <div>
          <p class="eyebrow">Architecture Themes</p>
          <h2>Areas where I like to create clarity.</h2>
        </div>
        <a
          class="button button-secondary"
          href="/projects/"
          data-analytics-event="view_projects_click"
          data-analytics-category="cta"
          data-analytics-label="View projects"
          data-analytics-location="work_case_studies"
        >
          View projects
        </a>
      </div>
      <div class="case-grid">
        {
          caseStudies.map((study) => (
            <article class="card case-card">
              <h3>{study.title}</h3>
              <p>{study.text}</p>
              <a
                class="text-link"
                href="/writing/"
                data-analytics-event="read_writing_click"
                data-analytics-category="cta"
                data-analytics-label="Read related notes"
                data-analytics-location="case_study_card"
              >
                Read related notes
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Next"
    title="Explore the projects behind the architecture thinking."
    description="The project archive connects these principles to real product systems, AI workflows, local model experiments, and personal tools."
    primaryLabel="View projects"
    primaryHref="/projects/"
    analyticsLocation="work_cta"
  />
</BaseLayout>

<style>
  .two-column {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 6vw, 4rem);
  }

  h2 {
    max-width: 40rem;
    margin: 0.35rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1;
  }

  .copy p {
    margin-top: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .strength-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .strength-grid span,
  .domain-list li {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 750;
    padding: 0.95rem;
  }

  .philosophy-band {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-muted) 42%, transparent);
  }

  .philosophy {
    max-width: 980px;
  }

  blockquote {
    margin: 0.7rem 0 0;
    color: var(--text);
    font-size: clamp(1.75rem, 4vw, 3.3rem);
    font-weight: 750;
    line-height: 1.08;
  }

  .domain-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .section-heading {
    max-width: 52rem;
    margin-bottom: 1.4rem;
  }

  .split {
    display: flex;
    max-width: none;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .case-card {
    display: grid;
    gap: 0.85rem;
    padding: 1.2rem;
  }

  .case-card h3,
  .case-card p {
    margin: 0;
  }

  .case-card p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .two-column,
    .strength-grid,
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .two-column,
    .strength-grid,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .split {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
