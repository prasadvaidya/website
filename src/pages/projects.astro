---
import { getCollection } from "astro:content";
import CTA from "../components/CTA.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortProjectsByMaturity } from "../utils/site";

const projects = sortProjectsByMaturity(await getCollection("projects"));
---

<BaseLayout
  title="Projects"
  description="Products, experiments, and prototypes by Prasad Vaidya — AI workflows, knowledge tools, local LLM experiments, and music learning systems."
>
  <PageHeader
    eyebrow="Projects"
    title="A workbench, not a <em>trophy case</em>."
    description="Products, experiments, and prototypes in various states of done. Each one is listed with the problem it attacks, why it matters, and what it's built from — including the parts that didn't work."
  />

  <section class="section-tight">
    <div class="container">
      <div class="project-list">
        {
          projects.map((project, index) => (
            <ProjectCard
              href={`/projects/${project.id}/`}
              title={project.data.title}
              problem={project.data.problem}
              stack={project.data.stack}
              status={project.data.status}
              index={index}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Further reading"
    title="The notes behind the systems."
    description="The writing archive explains the architecture judgment, AI workflow thinking, and product constraints behind these experiments."
    primaryLabel="Read writing"
    primaryHref="/writing/"
    analyticsLocation="projects_cta"
  />
</BaseLayout>

<style>
  .project-list {
    display: grid;
  }
</style>
