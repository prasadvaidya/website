---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortProjectsByMaturity } from "../utils/site";

const projects = sortProjectsByMaturity(await getCollection("projects"));
---

<BaseLayout
  title="Projects"
  description="Products, experiments, and prototypes by Prasad Vaidya: AI workflows, knowledge tools, local LLM experiments, and music learning tools."
>
  <div class="container page">
    <h1>Projects</h1>
    <p class="page-intro">
      Products, experiments, and prototypes in various states of done. The status
      labels are honest: "concept" means a folder of notes.
    </p>

    <ul class="project-list">
      {
        projects.map((project) => (
          <li>
            <h2>
              <a class="link" href={`/projects/${project.id}/`}>
                {project.data.title}
              </a>
              <span class="status">({project.data.status.toLowerCase()})</span>
            </h2>
            <p>{project.data.description}</p>
            <p class="stack">Built with {project.data.stack.join(", ")}.</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .page-intro {
    max-width: 38rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
  }

  .project-list {
    display: grid;
    gap: 2.2rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .status {
    margin-left: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .project-list p {
    max-width: 38rem;
    margin: 0.35rem 0 0;
  }

  .stack {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
