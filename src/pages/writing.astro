---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import CTA from "../components/CTA.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortByDate } from "../utils/site";

const posts = sortByDate((await getCollection("blog")).filter((post) => !post.data.draft));
const categories = [
  "Software Architecture",
  "AI Engineering",
  "Local LLMs",
  "SaaS Building",
  "Engineering Leadership",
  "Developer Productivity",
  "Personal Systems"
];

const plannedNotes = [
  { topic: "Software Architecture", line: "Systems that survive growth, pressure, and team change." },
  { topic: "AI Engineering", line: "Bounded agentic workflows with explicit failure modes." },
  { topic: "Local LLMs", line: "What small models can really do, measured on real hardware." },
  { topic: "SaaS Building", line: "Build logs from the road to independent products." },
  { topic: "Engineering Leadership", line: "Calm technical direction and decisions written down." },
  { topic: "Developer Productivity", line: "Tools, defaults, and feedback loops that reduce drag." },
  { topic: "Personal Systems", line: "Health, music, and habits as engineering projects." }
];
---

<BaseLayout
  title="Writing"
  description="Notes by Prasad Vaidya on software architecture, AI engineering, local LLMs, SaaS building, engineering leadership, and personal systems."
  noindex={posts.length === 0}
>
  <PageHeader
    eyebrow="Writing"
    title="Notes from the <em>workbench</em>."
    description="Long-form notes and decision frameworks: architecture judgment, AI workflows, build logs, and the personal systems that keep the work steady."
  />

  <section class="section-tight">
    <div class="container writing-list">
      {
        posts.length === 0 && (
          <div class="empty-writing">
            <div class="section-label">
              <span class="index">--</span>
              <span class="name">Coming soon</span>
            </div>
            <h2>The first entries are being drafted.</h2>
            <p>
              This is the index they'll fill. Subscribe to the
              <a href="/rss.xml">RSS feed</a> to catch the first one.
            </p>
            <ol class="planned-list">
              {plannedNotes.map((note) => (
                <li>
                  <span class="planned-topic">{note.topic}</span>
                  <span class="planned-line">{note.line}</span>
                  <span class="chip">soon</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        posts.length > 0 &&
        categories.map((category) => {
          const categoryPosts = posts.filter((post) => post.data.category === category);
          if (categoryPosts.length === 0) return null;
          return (
            <section id={category.toLowerCase().replaceAll(" ", "-")} class="category-section">
              <div class="section-label">
                <span class="index">§</span>
                <span class="name">{category}</span>
              </div>
              <div class="post-list">
                {categoryPosts.map((post) => (
                  <BlogCard
                    href={`/writing/${post.id}/`}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    readingTime={post.data.readingTime}
                    category={post.data.category}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </section>

  <CTA
    eyebrow="Meanwhile"
    title="The projects are already here."
    description="The workbench holds the systems these notes will describe — AI workflows, knowledge tools, and local model experiments."
    primaryLabel="View projects"
    primaryHref="/projects/"
    analyticsLocation="writing_cta"
  />
</BaseLayout>

<style>
  .writing-list {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .empty-writing h2 {
    margin: 1.4rem 0 0;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.05;
  }

  .empty-writing > p {
    max-width: 42rem;
    margin: 1rem 0 1.8rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .empty-writing > p a {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :global(.dark) .empty-writing > p a {
    color: var(--accent);
  }

  .planned-list {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .planned-list li {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--border);
    padding: 0.95rem 0.5rem;
  }

  .planned-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .planned-topic {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.08rem;
    font-weight: 580;
  }

  .planned-line {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .category-section {
    scroll-margin-top: 6rem;
  }

  .post-list {
    display: grid;
    margin-top: 1.2rem;
  }

  @media (max-width: 720px) {
    .planned-list li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .planned-list li .chip {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
    }

    .planned-line {
      grid-column: 1 / -1;
    }
  }
</style>
