---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortByDate } from "../utils/site";

const posts = sortByDate((await getCollection("blog")).filter((post) => !post.data.draft));
---

<BaseLayout
  title="Writing"
  description="Notes by Prasad Vaidya on software architecture, AI workflows, local LLMs, SaaS building, and personal systems."
  noindex={posts.length === 0}
>
  <div class="container page">
    <h1>Writing</h1>

    {
      posts.length === 0 ? (
        <>
          <p class="page-intro">
            Nothing here yet. I'd rather show you an empty page than filler.
          </p>
          <p>
            The first notes are in draft. They'll cover software architecture, AI
            workflows, local LLMs, SaaS building, and the systems side of health and
            guitar practice. There's an <a class="link" href="/rss.xml">RSS feed</a>
            if you'd like them as they're published.
          </p>
        </>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="link" href={`/writing/${post.id}/`}>
                {post.data.title}
              </a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .page-intro {
    margin: 0.9rem 0 0;
    color: var(--muted);
  }

  .page > p {
    max-width: 38rem;
    margin-top: 0.9rem;
  }

  .post-list {
    display: grid;
    gap: 1.4rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .post-list p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
