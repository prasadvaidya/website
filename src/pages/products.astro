---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const products = (await getCollection("products"))
  .filter((product) => !product.data.draft && !product.data.parentProduct)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
  title="Products"
  description="Independent products and early ideas by Prasad Vaidya, from useful software available today to focused concepts open for early access."
  canonical="/products/"
  keywords={["independent software products", "AI products", "product ideas", "early access"]}
>
  <div class="container page">
    <header>
      <p class="eyebrow">Independent products</p>
      <h1>Useful tools, tested in the open.</h1>
      <p class="page-intro">
        Products that are ready to use and focused ideas looking for the right early users.
        Each page explains the problem, the approach, and the next useful step.
      </p>
    </header>

    {
      products.length > 0 ? (
        <ul class="product-list">
          {products.map((product) => (
            <li>
              <a href={`/products/${product.id}/`} aria-label={`Explore ${product.data.title}`}>
                <span class="mode">
                  {product.data.mode === "live" ? "Available now" : "Early access"}
                </span>
                <h2>{product.data.title}</h2>
                <p>{product.data.description}</p>
                <span class="explore">Explore product →</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <h2>New product pages are being prepared.</h2>
          <p>
            In the meantime, the <a class="link" href="/projects/">projects archive</a> shows
            what I am building and testing.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.55rem, 5vw, 2.2rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .page-intro {
    max-width: 38rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
  }

  .product-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 2.8rem 0 0;
    padding: 0;
  }

  .product-list a,
  .empty-state {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 1.25rem;
  }

  .product-list a:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .mode {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.35rem 0 0;
    font-size: 1.08rem;
    font-weight: 650;
  }

  .product-list p,
  .empty-state p {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }

  .explore {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .empty-state {
    margin-top: 2.8rem;
  }

  .empty-state h2 {
    margin: 0;
  }
</style>
