---
import { getCollection, render } from "astro:content";
import CTA from "../../components/CTA.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl } from "../../utils/site";
import { personReference } from "../../utils/seo";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const canonical = `/projects/${project.id}/`;
const projectStructuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.description,
  url: absoluteUrl(canonical),
  creator: personReference(),
  about: project.data.problem,
  keywords: project.data.stack,
  inLanguage: "en",
  creativeWorkStatus: project.data.status
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  canonical={canonical}
  structuredData={projectStructuredData}
>
  <article class="project-detail">
    <header class="container detail-header">
      <a class="text-link" href="/projects/">Back to projects</a>
      <p class="eyebrow">Project</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <div class="meta-row">
        <span>{project.data.status}</span>
        {project.data.stack.map((item) => <span>{item}</span>)}
      </div>
    </header>

    <div class="container detail-grid">
      <aside class="summary surface">
        <h2>Project Summary</h2>
        <dl>
          <div>
            <dt>Problem</dt>
            <dd>{project.data.problem}</dd>
          </div>
          <div>
            <dt>Why it matters</dt>
            <dd>{project.data.whyItMatters}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{project.data.status}</dd>
          </div>
        </dl>
      </aside>
      <div class="prose-custom project-body">
        <Content />
      </div>
    </div>
  </article>

  <CTA
    eyebrow="Further Reading"
    title="Read related technical notes."
    description="The writing archive expands on the architecture patterns, product constraints, and AI workflow decisions behind these projects."
    primaryLabel="Read writing"
    primaryHref="/writing/"
    primaryEventName="read_writing_click"
    analyticsLocation="project_detail_cta"
  />
</BaseLayout>

<style>
  .project-detail {
    padding-bottom: 2rem;
  }

  .detail-header {
    padding-block: clamp(3.5rem, 9vw, 7rem) 2rem;
  }

  .detail-header .eyebrow {
    margin-top: 2rem;
  }

  h1 {
    max-width: 62rem;
    margin: 0.45rem 0 0;
    font-size: clamp(2.5rem, 7vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .detail-header p:not(.eyebrow) {
    max-width: 50rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.24rem);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .meta-row span {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 750;
    padding: 0.28rem 0.58rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.55fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 3rem);
  }

  .summary {
    position: sticky;
    top: 6rem;
    border-radius: 8px;
    padding: 1.15rem;
  }

  .summary h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  dt {
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.22rem 0 0;
    color: var(--muted);
  }

  .project-body {
    max-width: 760px;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .summary {
      position: static;
    }
  }
</style>
