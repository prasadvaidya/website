---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl } from "../../utils/site";
import { personReference } from "../../utils/seo";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const canonical = `/projects/${project.id}/`;
const projectStructuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.description,
  url: absoluteUrl(canonical),
  creator: personReference(),
  about: project.data.problem,
  keywords: project.data.stack,
  inLanguage: "en",
  creativeWorkStatus: project.data.status
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  canonical={canonical}
  structuredData={projectStructuredData}
>
  <article class="container page">
    <p class="back">
      <a class="link" href="/projects/">← Projects</a>
    </p>
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.description}</p>
    <p class="meta">
      Status: {project.data.status.toLowerCase()} · {project.data.stack.join(", ")}
    </p>
    <div class="prose-custom body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .back {
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }

  h1 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .lede {
    max-width: 38rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
  }

  .meta {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .body {
    max-width: 38rem;
    margin-top: 2rem;
  }
</style>
